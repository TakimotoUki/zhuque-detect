# 复制为 .env 并填入真实值
# 朱雀 API Key（EdgeOne 控制台 → Makers → Models → API Key 创建）
ZHUQUE_API_KEY=

# 可选：自定义上游地址（默认走腾讯官方网关）
# ZHUQUE_ENDPOINT=https://ai-gateway.edgeone.link/v1/providers/zhuque-text/classify

# 可选：起 HTTP 服务时要求调用方携带的令牌（对外暴露时务必设置）
# ZHUQUE_SERVER_TOKEN=

# 可选：单次请求超时（毫秒）
# ZHUQUE_TIMEOUT_MS=60000

# 可选：单块最大字符数，超过则自动分块
# ZHUQUE_MAX_CHARS=20000

# 可选：结果缓存有效期（毫秒），默认 10 分钟
# ZHUQUE_CACHE_TTL_MS=600000

# 可选：额外允许跨站访问的来源（英文逗号分隔）。
# 默认只允许本机页面；额外允许来源需明确配置。
# ZHUQUE_ALLOWED_ORIGINS=https://my.app,https://other.app

# 可选：检测历史最多保留多少条，默认 2000
# ZHUQUE_HISTORY_MAX=2000

# 可选：单条历史里原文最多存多少字，超出只存首尾片段，默认 0 = 完整保存
# ZHUQUE_HISTORY_TEXT_MAX=0
