#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# macOS 双击启动器：在 Finder 里双击本文件 → 打开服务管理菜单
# 等价于在终端执行： ./start.sh menu
#
# 若双击后提示「无法打开，因为无法验证开发者」，在「系统设置 → 隐私与安全性」
# 里点「仍要打开」，或先在终端执行一次：
#     chmod +x "启动.command"
# ---------------------------------------------------------------------------
cd "$(dirname "$0")" || exit 1
exec ./start.sh menu
